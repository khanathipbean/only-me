# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# mattpocock/skills: symlinked mirror of .agents/skills for Claude Code.
# core.symlinks=false on this machine makes `git add` copy file contents
# instead of storing a symlink, so ignore it and keep .agents/skills as
# the single source of truth. Regenerate with:
#   npx skills@latest add mattpocock/skills
.claude/skills
