// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedProjects   Project[]       @relation("ProjectOwner")
  updatedProjects Project[]       @relation("ProjectUpdatedBy")
  memberships     ProjectMember[]
  auditLogs       AuditLog[]
  ownedScenarios      Scenario[]
  ownedTestGroups     TestGroup[]
  assignedTestCases   TestCase[]   @relation("TestCaseAssignee")
  createdTestCases    TestCase[]   @relation("TestCaseCreatedBy")
  updatedTestCases    TestCase[]   @relation("TestCaseUpdatedBy")
  uploadedAttachments Attachment[]
  performedImports    ImportLog[]
  uploadedFiles       ProjectFile[]
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
}

enum ProjectRole {
  ADMIN
  QA_LEAD
  TESTER
  VIEWER
}

model Project {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  description   String?
  status        ProjectStatus @default(DRAFT)
  startDate     DateTime?
  endDate       DateTime?
  ownerId       String
  updatedById   String?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  owner         User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  updatedBy     User?           @relation("ProjectUpdatedBy", fields: [updatedById], references: [id])
  members       ProjectMember[]
  auditLogs     AuditLog[]
  scenarios     Scenario[]
  importLogs    ImportLog[]
  files         ProjectFile[]
  modules       Module[]
  requirements  Requirement[]
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole
  createdAt DateTime    @default(now())

  project   Project @relation(fields: [projectId], references: [id])
  user      User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String
  projectId  String
  occurredAt DateTime @default(now())
  oldValue   Json?
  newValue   Json?

  actor   User    @relation(fields: [actorId], references: [id])
  project Project @relation(fields: [projectId], references: [id])
}

/** Shared priority for Scenario and Test Case. */
enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TestType {
  POSITIVE
  NEGATIVE
  BOUNDARY
}

enum TestResult {
  NOT_RUN
  PASSED
  FAILED
  BLOCKED
  SKIPPED
}

/** Shared workflow status for Scenario, Test Group, and Test Case. */
enum WorkflowStatus {
  DRAFT
  READY
  IN_PROGRESS
  COMPLETED
}

model Scenario {
  id             String           @id @default(cuid())
  projectId      String
  /// Mandatory: a Scenario is reached through its Requirement, which is
  /// reached through its Module, so one without a Requirement would have no
  /// URL at all. `projectId` above is kept for now; removing it and resolving
  /// the Project through here is its own change.
  requirementId  String
  name           String
  description    String?
  preconditions  String?
  testData       String?
  steps          String?
  expectedResult String
  priority       Priority
  status         WorkflowStatus   @default(DRAFT)
  tags           String[]         @default([])
  ownerId        String?
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  project     Project      @relation(fields: [projectId], references: [id])
  requirement Requirement  @relation(fields: [requirementId], references: [id])
  owner       User?        @relation(fields: [ownerId], references: [id])
  testGroups  TestGroup[]
}

model TestGroup {
  id            String         @id @default(cuid())
  scenarioId    String
  name          String
  description   String?
  testObjective String?
  sequence      Int
  status        WorkflowStatus @default(DRAFT)
  ownerId       String?
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  scenario  Scenario   @relation(fields: [scenarioId], references: [id])
  owner     User?      @relation(fields: [ownerId], references: [id])
  testCases TestCase[]
}

model TestCase {
  id             String      @id @default(cuid())
  testGroupId    String
  name           String
  condition      String?
  preconditions  String?
  testData       String?
  expectedResult String
  priority       Priority
  testType       TestType?
  status         WorkflowStatus @default(DRAFT)
  testResult     TestResult  @default(NOT_RUN)
  assigneeId     String?
  notes          String?
  deletedAt      DateTime?
  createdById    String
  updatedById    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  testGroup   TestGroup    @relation(fields: [testGroupId], references: [id])
  assignee    User?        @relation("TestCaseAssignee", fields: [assigneeId], references: [id])
  createdBy   User         @relation("TestCaseCreatedBy", fields: [createdById], references: [id])
  updatedBy   User?        @relation("TestCaseUpdatedBy", fields: [updatedById], references: [id])
  steps       TestStep[]
  attachments Attachment[]
}

model TestStep {
  id             String @id @default(cuid())
  testCaseId     String
  sequence       Int
  step           String
  expectedResult String

  testCase TestCase @relation(fields: [testCaseId], references: [id])
}

model Attachment {
  id           String   @id @default(cuid())
  testCaseId   String
  storageKey   String
  fileName     String
  uploadedById String
  uploadedAt   DateTime @default(now())

  testCase   TestCase @relation(fields: [testCaseId], references: [id])
  uploadedBy User     @relation(fields: [uploadedById], references: [id])
}

model ImportLog {
  id             String   @id @default(cuid())
  projectId      String
  performedById  String
  occurredAt     DateTime @default(now())
  succeededCount Int
  failedCount    Int
  skippedCount   Int
  details        Json

  project     Project @relation(fields: [projectId], references: [id])
  performedBy User    @relation(fields: [performedById], references: [id])
}

/// A document kept against the Project — a spec, a report, an assessment.
/// Stored and listed only; nothing reads the contents.
model ProjectFile {
  id           String    @id @default(cuid())
  projectId    String
  /// Free-text heading the file was listed under before Modules existed.
  /// Kept until every row has a `moduleId`, then dropped.
  module       String
  moduleId     String?
  /// The name the uploader's file had. Display only — never used to build a
  /// path, so a name containing ".." can't escape the upload directory.
  fileName     String
  /// Random name the bytes actually live under on disk.
  storageKey   String    @unique
  contentType  String
  size         Int
  uploadedById String
  uploadedAt   DateTime  @default(now())
  deletedAt    DateTime?

  project      Project @relation(fields: [projectId], references: [id])
  moduleRef    Module? @relation(fields: [moduleId], references: [id])
  uploadedBy   User    @relation(fields: [uploadedById], references: [id])

  @@index([projectId, module])
}

/// One menu of the system under test — Dashboard, Workflow, Sprints.
///
/// A table rather than a text column because the same names are chosen over
/// and over, by Requirements and by the documents filed against them: free
/// text means "Dashboard" and "dashboard" quietly become two groups. It is
/// deliberately *not* a level of the hierarchy — nothing nests under it, it
/// groups and filters.
model Module {
  id        String    @id @default(cuid())
  projectId String
  name      String
  /// Display order, so the list can mirror the real menu.
  sequence  Int       @default(0)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project      Project       @relation(fields: [projectId], references: [id])
  requirements Requirement[]
  files        ProjectFile[]

  @@unique([projectId, name])
}

/// What the Feature docs boil down to: a statement the tests must prove.
/// Sits between a Project and its Scenarios.
model Requirement {
  id          String         @id @default(cuid())
  projectId   String
  moduleId    String
  /// Reference used in the source document, e.g. "REQ-014".
  code        String?
  name        String
  description String?
  priority    Priority       @default(MEDIUM)
  status      WorkflowStatus @default(DRAFT)
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project   Project    @relation(fields: [projectId], references: [id])
  module    Module     @relation(fields: [moduleId], references: [id])
  scenarios Scenario[]

  @@index([projectId, moduleId])
}
